{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 17 — The bust, now aligned with chart 16's survival-horizon control. One dot per SA2 (>=5 venues in the July 2022 cohort): fixed public-transport access (share of the SA2's venues within 400 m of a stop, x) against licence survival at the selected 1/2/3-year horizon (y), coloured metro (teal) / regional (orange), dot size = cohort size. The transport definition is intentionally fixed at 400 m, matching the page's access choropleth. The survival horizon is dynamic: a Vega-Lite calculate transform swaps survival_rate_1yr_pct / survival_rate_2yr_pct / survival_rate_3yr_pct into survival_rate_T. The per-region regression lines recompute at each horizon and remain flat, so proximity never becomes a strong survival predictor. Two SA2s are ringed as counter-examples — South Yarra - South (near a stop, low survival) and Bright - Mount Beauty (low access, higher survival); both labels update their survival value with the selected horizon. The chart is also a linked-highlight node: pick_17 captures a clicked SA2 for the page's cross-chart highlight, and selected_sa2 (driven from the survival maps, access choropleth, or the 'find your suburb' box) pins one SA2's dot. Survival is a licence-presence proxy; association only. Data: chart_sa2_survival.csv (from scripts/derive_survival.py, augmented by scripts/derive_access_thresholds.py).",
  "title": {
    "text": "Closer to transport, no better odds of surviving",
    "subtitle": [
      "Each dot is an SA2. Near is fixed at the assignment's 400 m definition.",
      "Pick the survival horizon: the years change, but the access-survival line stays flat."
    ],
    "anchor": "start",
    "subtitleFontStyle": "italic"
  },
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/chart_sa2_survival.csv",
    "format": {
      "parse": {
        "sa2_code_2021": "string"
      }
    }
  },
  "params": [
    {
      "name": "horizonYears",
      "value": 2,
      "bind": {
        "input": "select",
        "options": [
          1,
          2,
          3
        ],
        "labels": [
          "1 year (still open July 2023)",
          "2 years (still open July 2024)",
          "3 years (still open July 2025)"
        ],
        "name": "Survival horizon: "
      }
    },
    {
      "name": "selected_sa2",
      "value": null
    }
  ],
  "transform": [
    {
      "filter": "datum.metro_regional_majority == 'Metro' || datum.metro_regional_majority == 'Regional'"
    },
    {
      "filter": "datum.access_share_pct != null"
    },
    {
      "calculate": "datum.share_400",
      "as": "access_share_T"
    },
    {
      "calculate": "horizonYears === 1 ? datum.survival_rate_1yr_pct : (horizonYears === 2 ? datum.survival_rate_2yr_pct : datum.survival_rate_3yr_pct)",
      "as": "survival_rate_T"
    },
    {
      "calculate": "horizonYears + (horizonYears === 1 ? ' year' : ' years')",
      "as": "horizon_label_T"
    }
  ],
  "encoding": {
    "x": {
      "field": "access_share_T",
      "type": "quantitative",
      "title": "Venues within 400 m of a stop (%)",
      "scale": {
        "domain": [
          0,
          100
        ]
      }
    },
    "y": {
      "field": "survival_rate_T",
      "type": "quantitative",
      "title": "Venues still licensed at selected horizon (%)",
      "scale": {
        "domain": [
          55,
          100
        ]
      }
    },
    "color": {
      "field": "metro_regional_majority",
      "type": "nominal",
      "title": "Region",
      "scale": {
        "domain": [
          "Metro",
          "Regional"
        ],
        "range": [
          "#1b9e77",
          "#d95f02"
        ]
      }
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "pick_17",
          "select": {
            "type": "point",
            "fields": [
              "sa2_code_2021"
            ],
            "on": "click",
            "toggle": "event.shiftKey"
          }
        }
      ],
      "mark": {
        "type": "circle"
      },
      "encoding": {
        "size": {
          "field": "cohort_count",
          "type": "quantitative",
          "title": "Venues (2022)",
          "scale": {
            "range": [
              20,
              400
            ]
          },
          "legend": { "format": "," }
        },
        "opacity": {
          "condition": {
            "test": "selected_sa2 == null || datum.sa2_code_2021 == selected_sa2",
            "value": 0.5
          },
          "value": 0.08
        },
        "stroke": {
          "condition": {
            "test": "selected_sa2 != null && datum.sa2_code_2021 == selected_sa2",
            "value": "#1a1a1a"
          },
          "value": null
        },
        "strokeWidth": {
          "value": 1.4
        },
        "tooltip": [
          {
            "field": "sa2_name_2021",
            "type": "nominal",
            "title": "SA2"
          },
          {
            "field": "metro_regional_majority",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "access_share_T",
            "type": "quantitative",
            "title": "Within 400 m of a stop",
            "format": ".0f"
          },
          {
            "field": "horizon_label_T",
            "type": "nominal",
            "title": "Survival horizon"
          },
          {
            "field": "median_nearest_stop_distance_m",
            "type": "quantitative",
            "title": "Median walk to stop (m)",
            "format": ","
          },
          {
            "field": "irsad_aus_decile",
            "type": "ordinal",
            "title": "SEIFA decile"
          },
          {
            "field": "survival_rate_T",
            "type": "quantitative",
            "title": "Still licensed",
            "format": ".1f"
          },
          {
            "field": "cohort_count",
            "type": "quantitative",
            "title": "Venues (2022)",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "regression": "survival_rate_T",
          "on": "access_share_T",
          "groupby": [
            "metro_regional_majority"
          ]
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 3
      }
    },
    {
      "description": "Counter-example rings at the fixed 400 m access definition: South Yarra - South (206061516) and Bright - Mount Beauty (204031069).",
      "transform": [
        {
          "filter": "datum.sa2_code_2021 == '206061516' || datum.sa2_code_2021 == '204031069'"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "fill": null,
        "stroke": "#1a1a1a",
        "strokeWidth": 1.4,
        "size": 170,
        "opacity": 0.9
      },
      "encoding": {
        "color": null
      }
    },
    {
      "description": "Dynamic compact multi-line label for the high-access / low-survival counter-example (South Yarra - South); survival updates with the selected horizon.",
      "transform": [
        {
          "filter": "datum.sa2_code_2021 == '206061516'"
        },
        {
          "calculate": "['South Yarra', format(datum.access_share_T, '.0f') + '% near', format(datum.survival_rate_T, '.0f') + '% survived']",
          "as": "calloutLabel"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -12,
        "lineHeight": 13,
        "fontSize": 11,
        "color": "#1a1a1a"
      },
      "encoding": {
        "text": {
          "field": "calloutLabel",
          "type": "nominal"
        },
        "color": null
      }
    },
    {
      "description": "Dynamic compact multi-line label for the low-access / higher-survival counter-example (Bright - Mount Beauty).",
      "transform": [
        {
          "filter": "datum.sa2_code_2021 == '204031069'"
        },
        {
          "calculate": "['Bright–Mt Beauty', 'only ' + format(datum.access_share_T, '.0f') + '% near', format(datum.survival_rate_T, '.0f') + '% survived']",
          "as": "calloutLabel"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 12,
        "lineHeight": 13,
        "fontSize": 11,
        "color": "#1a1a1a"
      },
      "encoding": {
        "text": {
          "field": "calloutLabel",
          "type": "nominal"
        },
        "color": null
      }
    },
    {
      "description": "Corner readout of the active survival horizon and fixed access threshold.",
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "fontStyle": "italic",
        "fontSize": 12,
        "color": "#666",
        "x": {
          "expr": "width"
        },
        "y": 4,
        "text": {
          "expr": "'near = within 400 m; survival = ' + horizonYears + (horizonYears === 1 ? ' year' : ' years')"
        }
      },
      "encoding": {
        "color": null
      }
    },
    {
      "description": "Label for the actual (solid) regression lines.",
      "data": {
        "values": [
          {
            "access_share_T": 82,
            "survival_rate_T": 81
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dy": -4,
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#1b9e77",
        "text": "actual ≈ flat"
      },
      "encoding": {
        "x": {
          "field": "access_share_T",
          "type": "quantitative"
        },
        "y": {
          "field": "survival_rate_T",
          "type": "quantitative"
        },
        "color": null
      }
    },
    {
      "description": "Dynamic horizontal reference rule at the Metro within-400m group mean survival for the selected horizon.",
      "data": {
        "url": "data/chart_survival_summary.csv"
      },
      "transform": [
        {
          "filter": "datum.horizon_years == horizonYears && datum.metro_regional == 'Metro' && datum.proximity == 'Within 400 m of a stop'"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeDash": [
          3,
          3
        ],
        "strokeWidth": 1,
        "color": "#888",
        "strokeOpacity": 0.7
      },
      "encoding": {
        "y": {
          "field": "survival_rate_pct",
          "type": "quantitative"
        },
        "color": null
      }
    },
    {
      "description": "Dynamic label for the Metro within-400m group mean.",
      "data": {
        "url": "data/chart_survival_summary.csv"
      },
      "transform": [
        {
          "filter": "datum.horizon_years == horizonYears && datum.metro_regional == 'Metro' && datum.proximity == 'Within 400 m of a stop'"
        },
        {
          "calculate": "'within 400 m avg. = ' + format(datum.survival_rate_pct, '.1f') + '%'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dy": -2,
        "fontSize": 10,
        "color": "#555"
      },
      "encoding": {
        "x": {
          "value": 4
        },
        "y": {
          "field": "survival_rate_pct",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": null
      }
    },
    {
      "description": "Dynamic horizontal reference rule at the Metro further-than-400m group mean survival for the selected horizon.",
      "data": {
        "url": "data/chart_survival_summary.csv"
      },
      "transform": [
        {
          "filter": "datum.horizon_years == horizonYears && datum.metro_regional == 'Metro' && datum.proximity == 'Further than 400 m'"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeDash": [
          3,
          3
        ],
        "strokeWidth": 1,
        "color": "#888",
        "strokeOpacity": 0.7
      },
      "encoding": {
        "y": {
          "field": "survival_rate_pct",
          "type": "quantitative"
        },
        "color": null
      }
    },
    {
      "description": "Dynamic label for the Metro further-than-400m group mean.",
      "data": {
        "url": "data/chart_survival_summary.csv"
      },
      "transform": [
        {
          "filter": "datum.horizon_years == horizonYears && datum.metro_regional == 'Metro' && datum.proximity == 'Further than 400 m'"
        },
        {
          "calculate": "'further out avg. = ' + format(datum.survival_rate_pct, '.1f') + '%'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dy": -2,
        "fontSize": 10,
        "color": "#555"
      },
      "encoding": {
        "x": {
          "value": 4
        },
        "y": {
          "field": "survival_rate_pct",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": null
      }
    },
    {
      "description": "Caveat badge: survival is a licence-presence proxy, not a direct closure measure.",
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontStyle": "italic",
        "fontSize": 10,
        "color": "#999",
        "x": {
          "expr": "4"
        },
        "y": {
          "expr": "4"
        },
        "text": "survival = licence presence (proxy)"
      },
      "encoding": {
        "color": null
      }
    }
  ]
}
