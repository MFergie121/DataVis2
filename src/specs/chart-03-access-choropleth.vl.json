{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 03 — Access-share choropleth zoomed to inner & middle-ring Melbourne (224 SA2s). Share of each SA2's venues within 400 m of a public-transport stop, on an equal-area conic projection — equal-area is principled because colour, not polygon area, carries the value. Zoomed to metro so the near-universal access reads at suburb scale; the regional comparison it can no longer show is carried by the strip plot (chart-06). This map is a node of the page's linked highlight: clicking an SA2 (sa2_sel) drives selected_sa2 across the page, and the map's own highlight is driven by selected_sa2 in turn. Regional SA2s are not on this map, so off-map selections are suppressed in index.html (the map stays fully lit rather than greying out). Single geoshape layer — no inline overlay layer — to keep projection auto-fit clean (see vega-lite-projection-fit-gotcha). Data: sa2_summary_web.csv joined to sa2_melbourne.topojson on sa2_code_2021.",
  "title": {
    "text": "In inner Melbourne, nearly every venue is a short walk from transport",
    "subtitle": [
      "Each region is an SA2 · 224 inner-Melbourne SA2s · darker = higher share within 400 m.",
      "Typically about 9 in 10 venues qualify. Click a region to highlight it below."
    ],
    "anchor": "start",
    "subtitleFontStyle": "italic"
  },
  "width": "container",
  "height": 460,
  "params": [
    {
      "name": "selected_sa2",
      "value": null
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -145.05,
      0,
      0
    ],
    "center": [
      0,
      -37.795
    ],
    "parallels": [
      -37.7,
      -37.9
    ]
  },
  "layer": [
    {
      "params": [
        {
          "name": "sa2_sel",
          "select": {
            "type": "point",
            "fields": [
              "sa2_code_2021"
            ],
            "on": "click",
            "toggle": "event.shiftKey"
          }
        }
      ],
      "data": {
        "url": "data/sa2_melbourne.topojson",
        "format": {
          "type": "topojson",
          "feature": "sa2_summary"
        }
      },
      "transform": [
        {
          "lookup": "properties.sa2_code_2021",
          "from": {
            "data": {
              "url": "data/sa2_summary_web.csv",
              "format": {
                "parse": {
                  "sa2_code_2021": "string"
                }
              }
            },
            "key": "sa2_code_2021",
            "fields": [
              "access_share_pct",
              "sa2_name_2021",
              "metro_regional_majority",
              "venue_count",
              "median_nearest_stop_distance_m",
              "median_stops_within_400m",
              "irsad_aus_decile"
            ]
          }
        },
        {
          "calculate": "datum.properties.sa2_code_2021",
          "as": "sa2_code_2021"
        },
        {
          "calculate": "datum.access_share_pct == null ? 'No data' : datum.access_share_pct < 20 ? '0–20%' : datum.access_share_pct < 40 ? '20–40%' : datum.access_share_pct < 60 ? '40–60%' : datum.access_share_pct < 80 ? '60–80%' : '80–100%'",
          "as": "access_class"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.3
      },
      "encoding": {
        "color": {
          "field": "access_class",
          "type": "ordinal",
          "title": [
            "Venues within",
            "400 m of a stop"
          ],
          "scale": {
            "domain": ["0–20%", "20–40%", "40–60%", "60–80%", "80–100%", "No data"],
            "range": ["#cceef0", "#80cdc1", "#35978f", "#01665e", "#003c30", "#cccccc"]
          },
          "legend": {
            "symbolType": "square",
            "symbolSize": 150
          }
        },
        "opacity": {
          "condition": {
            "test": "selected_sa2 == null || datum.sa2_code_2021 == selected_sa2",
            "value": 1
          },
          "value": 0.35
        },
        "stroke": {
          "condition": {
            "test": "selected_sa2 != null && datum.sa2_code_2021 == selected_sa2",
            "value": "#1a1a1a"
          },
          "value": "#ffffff"
        },
        "strokeWidth": {
          "condition": {
            "test": "selected_sa2 != null && datum.sa2_code_2021 == selected_sa2",
            "value": 1.6
          },
          "value": 0.3
        },
        "tooltip": [
          {
            "field": "sa2_name_2021",
            "type": "nominal",
            "title": "SA2"
          },
          {
            "field": "metro_regional_majority",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "access_share_pct",
            "type": "quantitative",
            "title": "Within 400 m",
            "format": ".0f"
          },
          {
            "field": "median_nearest_stop_distance_m",
            "type": "quantitative",
            "title": "Median walk to stop (m)",
            "format": ","
          },
          {
            "field": "median_stops_within_400m",
            "type": "quantitative",
            "title": "Stops within 400 m (median)",
            "format": ","
          },
          {
            "field": "irsad_aus_decile",
            "type": "ordinal",
            "title": "SEIFA decile"
          },
          {
            "field": "venue_count",
            "type": "quantitative",
            "title": "Venues",
            "format": ","
          }
        ]
      }
    }
  ]
}
