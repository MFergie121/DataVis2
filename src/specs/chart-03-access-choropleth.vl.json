{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 03 — Access-share choropleth. Share of each SA2's venues within 400 m of a public-transport stop, mapped on an equal-area projection of Victoria. Equal-area is principled here because colour, not polygon area, carries the value. This map is a node of the page's linked highlight: clicking an SA2 (sa2_sel) drives selected_sa2 across the page, and the map's own highlight is in turn driven by selected_sa2 — so it lights up whether the selection came from a click here, from the paradox scatter (chart-06), or from the 'find your suburb' box. A text callout anchored over Port Phillip Bay points at the metro cluster and states the headline access figure. Data: sa2_summary_web.csv joined to sa2_summary_simplified.topojson on sa2_code_2021.",
  "title": {
    "text": "Share of venues within 400 m of a stop, by SA2",
    "subtitle": "Darker = more of the area's venues sit within a five-minute walk of a stop. Click a region to highlight it below.",
    "anchor": "start",
    "subtitleFontStyle": "italic"
  },
  "width": "container",
  "height": 460,
  "params": [
    { "name": "selected_sa2", "value": null }
  ],
  "projection": {
    "type": "conicEqualArea",
    "rotate": [-145, 0, 0],
    "center": [0, -37],
    "parallels": [-36, -38]
  },
  "layer": [
    {
      "params": [
        {
          "name": "sa2_sel",
          "select": { "type": "point", "fields": ["sa2_code_2021"], "on": "click", "toggle": "event.shiftKey" }
        }
      ],
      "data": {
        "url": "data/sa2_summary_simplified.topojson",
        "format": { "type": "topojson", "feature": "sa2_summary" }
      },
      "transform": [
        {
          "lookup": "properties.sa2_code_2021",
          "from": {
            "data": {
              "url": "data/sa2_summary_web.csv",
              "format": { "parse": { "sa2_code_2021": "string" } }
            },
            "key": "sa2_code_2021",
            "fields": ["access_share_pct", "sa2_name_2021", "metro_regional_majority", "venue_count", "median_nearest_stop_distance_m", "median_stops_within_400m", "irsad_aus_decile"]
          }
        },
        { "calculate": "datum.properties.sa2_code_2021", "as": "sa2_code_2021" }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.3
      },
      "encoding": {
        "color": {
          "field": "access_share_pct",
          "type": "quantitative",
          "title": ["Venues within", "400 m of a stop"],
          "scale": { "scheme": "teals", "domain": [0, 100] },
          "legend": { "format": ".0f", "gradientLength": 160 }
        },
        "opacity": {
          "condition": { "test": "selected_sa2 == null || datum.sa2_code_2021 == selected_sa2", "value": 1 },
          "value": 0.35
        },
        "stroke": {
          "condition": { "test": "selected_sa2 != null && datum.sa2_code_2021 == selected_sa2", "value": "#1a1a1a" },
          "value": "#ffffff"
        },
        "strokeWidth": {
          "condition": { "test": "selected_sa2 != null && datum.sa2_code_2021 == selected_sa2", "value": 1.6 },
          "value": 0.3
        },
        "tooltip": [
          { "field": "sa2_name_2021", "type": "nominal", "title": "SA2" },
          { "field": "metro_regional_majority", "type": "nominal", "title": "Region" },
          { "field": "access_share_pct", "type": "quantitative", "title": "Within 400 m", "format": ".0f" },
          { "field": "median_nearest_stop_distance_m", "type": "quantitative", "title": "Median walk to stop (m)", "format": "," },
          { "field": "median_stops_within_400m", "type": "quantitative", "title": "Stops within 400 m (median)", "format": "," },
          { "field": "irsad_aus_decile", "type": "ordinal", "title": "SEIFA decile" },
          { "field": "venue_count", "type": "quantitative", "title": "Venues", "format": "," }
        ]
      }
    },
    {
      "description": "Callout over Port Phillip Bay (white water, no polygon) pointing up at the dense metro cluster.",
      "data": { "values": [{ "lon": 144.92, "lat": -38.18, "label": ["Greater Melbourne:", "~86% of venues within 400 m"] }] },
      "mark": { "type": "text", "align": "center", "baseline": "top", "fontSize": 11, "lineHeight": 13, "fontWeight": "bold", "color": "#1a3a3a" },
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },
        "text": { "field": "label", "type": "nominal" }
      }
    }
  ]
}
