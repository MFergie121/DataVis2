{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 08 — Best- and worst-served SA2s. A lollipop ranking of the 15 SA2s with the highest and lowest share of venues within 400 m of a stop. Use the toggle to switch ends. The worst-served list is almost entirely regional (orange); the best-served are inner-metro (teal) — putting concrete place names on the metro/regional divide. Data: chart_sa2_rankings.csv (access rankings).",
  "title": {
    "text": "Put names to the gap: the worst-served SA2s are nearly all regional",
    "anchor": "start"
  },
  "width": "container",
  "height": 360,
  "params": [
    {
      "name": "view",
      "value": "lowest_access",
      "bind": {
        "input": "radio",
        "options": ["lowest_access", "highest_access"],
        "labels": ["Worst served (lowest access)", "Best served (highest access)"],
        "name": "Show:  "
      }
    }
  ],
  "data": { "url": "data/chart_sa2_rankings.csv" },
  "transform": [
    { "filter": "datum.ranking_type == view" }
  ],
  "encoding": {
    "y": {
      "field": "sa2_name_2021",
      "type": "nominal",
      "title": null,
      "sort": { "field": "access_share_pct", "order": "descending" }
    },
    "x": {
      "field": "access_share_pct",
      "type": "quantitative",
      "title": "Venues within 400 m of a stop (%)",
      "scale": { "domain": [0, 100] }
    },
    "color": {
      "field": "metro_regional_majority",
      "type": "nominal",
      "title": "Region",
      "scale": { "domain": ["Metro", "Regional"], "range": ["#1b9e77", "#d95f02"] }
    }
  },
  "layer": [
    {
      "mark": { "type": "rule", "strokeWidth": 2 },
      "encoding": { "x2": { "datum": 0 } }
    },
    {
      "mark": { "type": "point", "filled": true, "size": 90, "opacity": 1 },
      "encoding": {
        "tooltip": [
          { "field": "sa2_name_2021", "type": "nominal", "title": "SA2" },
          { "field": "metro_regional_majority", "type": "nominal", "title": "Region" },
          { "field": "access_share_pct", "type": "quantitative", "title": "Within 400 m", "format": ".0f" },
          { "field": "venue_count", "type": "quantitative", "title": "Venues", "format": "," }
        ]
      }
    }
  ]
}
