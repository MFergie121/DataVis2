{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 05 — Bivariate access x SEIFA map. Each SA2 is shaded by a two-variable colour: transport access (share of venues within 400 m of a stop, split into terciles at 72 and 92.5) crossed with socio-economic advantage (ABS SEIFA IRSAD decile group). Reading the diagonal sets up the expectation that access and advantage move together — which the hero (chart-06) then overturns. The bivariate palette (Stevens pink-blue 3x3) is reserved for this one map. SA2s missing either value render as empty (white). Data: sa2_summary_web.csv joined to sa2_summary_simplified.topojson on sa2_code_2021.",
  "resolve": { "scale": { "color": "independent" } },
  "hconcat": [
    {
      "width": 600,
      "height": 480,
      "data": {
        "url": "data/sa2_summary_simplified.topojson",
        "format": { "type": "topojson", "feature": "sa2_summary" }
      },
      "transform": [
        {
          "lookup": "properties.sa2_code_2021",
          "from": {
            "data": {
              "url": "data/sa2_summary_web.csv",
              "format": { "parse": { "sa2_code_2021": "string" } }
            },
            "key": "sa2_code_2021",
            "fields": ["access_share_pct", "seifa_decile_group", "irsad_aus_decile", "sa2_name_2021", "metro_regional_majority"]
          }
        },
        {
          "calculate": "datum.access_share_pct == null ? 'na' : (datum.access_share_pct < 72 ? 'low' : (datum.access_share_pct < 92.5 ? 'mid' : 'high'))",
          "as": "access_level"
        },
        {
          "calculate": "datum.seifa_decile_group == 'low_1_3' ? 'low' : (datum.seifa_decile_group == 'middle_4_7' ? 'mid' : (datum.seifa_decile_group == 'high_8_10' ? 'high' : 'na'))",
          "as": "seifa_level"
        },
        {
          "calculate": "datum.access_level == 'na' || datum.seifa_level == 'na' ? 'na' : datum.access_level + '-' + datum.seifa_level",
          "as": "biclass"
        }
      ],
      "projection": {
        "type": "conicEqualArea",
        "rotate": [-145, 0, 0],
        "center": [0, -37],
        "parallels": [-36, -38]
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#cfcdc6",
        "strokeWidth": 0.3
      },
      "encoding": {
        "color": {
          "field": "biclass",
          "type": "nominal",
          "scale": {
            "domain": ["low-low", "low-mid", "low-high", "mid-low", "mid-mid", "mid-high", "high-low", "high-mid", "high-high", "na"],
            "range": ["#e8e8e8", "#dfb0d6", "#be64ac", "#ace4e4", "#a5add3", "#8c62aa", "#5ac8c8", "#5698b9", "#3b4994", "#ffffff"]
          },
          "legend": null
        },
        "tooltip": [
          { "field": "sa2_name_2021", "type": "nominal", "title": "SA2" },
          { "field": "metro_regional_majority", "type": "nominal", "title": "Region" },
          { "field": "access_share_pct", "type": "quantitative", "title": "Within 400 m", "format": ".0f" },
          { "field": "irsad_aus_decile", "type": "quantitative", "title": "SEIFA decile (1-10)" }
        ]
      }
    },
    {
      "description": "Hand-built 3x3 bivariate legend.",
      "width": 96,
      "height": 96,
      "data": {
        "values": [
          { "access": "low", "seifa": "low", "cls": "low-low" },
          { "access": "mid", "seifa": "low", "cls": "mid-low" },
          { "access": "high", "seifa": "low", "cls": "high-low" },
          { "access": "low", "seifa": "mid", "cls": "low-mid" },
          { "access": "mid", "seifa": "mid", "cls": "mid-mid" },
          { "access": "high", "seifa": "mid", "cls": "high-mid" },
          { "access": "low", "seifa": "high", "cls": "low-high" },
          { "access": "mid", "seifa": "high", "cls": "mid-high" },
          { "access": "high", "seifa": "high", "cls": "high-high" }
        ]
      },
      "mark": { "type": "rect", "stroke": "#ffffff", "strokeWidth": 1 },
      "encoding": {
        "x": {
          "field": "access",
          "type": "ordinal",
          "sort": ["low", "mid", "high"],
          "title": "Access →",
          "axis": { "labelAngle": 0, "domain": false, "ticks": false, "labelPadding": 2 }
        },
        "y": {
          "field": "seifa",
          "type": "ordinal",
          "sort": ["high", "mid", "low"],
          "title": "Advantage →",
          "axis": { "domain": false, "ticks": false, "labelPadding": 2 }
        },
        "color": {
          "field": "cls",
          "type": "nominal",
          "scale": {
            "domain": ["low-low", "low-mid", "low-high", "mid-low", "mid-mid", "mid-high", "high-low", "high-mid", "high-high"],
            "range": ["#e8e8e8", "#dfb0d6", "#be64ac", "#ace4e4", "#a5add3", "#8c62aa", "#5ac8c8", "#5698b9", "#3b4994"]
          },
          "legend": null
        }
      }
    }
  ]
}
