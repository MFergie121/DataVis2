{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 11 — Statewide overview of where venues sit against the transport network. Train + tram ROUTES (where public transport runs) are drawn over the full mesh of ~31,170 PT STOPS (where you can get on), with venues binned into coarse lon/lat cells and plotted as warm density circles. This is a proximity/context map, not a service map — lines show where routes go and dots show where stops are, never when or how often services run (GTFS schedule deliberately deferred; the page says 'near', not 'served by'). Full-width and tall so Victoria fills the frame and the route skeleton is legible. Data: venues_web.csv aggregated in-spec; transport_stops_web.csv as stop points; pt_routes_simplified.topojson as lines; sa2_summary_simplified.topojson as the base.",
  "title": {
    "text": "Venues and public transport — Victoria",
    "subtitle": [
      "Venue density, stops, and train/tram routes in one statewide frame.",
      "Proximity, not service frequency."
    ],
    "anchor": "start"
  },
  "width": "container",
  "height": 520,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -145,
      0,
      0
    ],
    "center": [
      0,
      -37
    ],
    "parallels": [
      -36,
      -38
    ]
  },
  "layer": [
    {
      "description": "Base: SA2 boundaries for geographic context (same base as the venue map).",
      "data": {
        "url": "data/sa2_summary_simplified.topojson",
        "format": {
          "type": "topojson",
          "feature": "sa2_summary"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f0efe9",
        "stroke": "#ffffff",
        "strokeWidth": 0.4
      }
    },
    {
      "description": "Every public-transport stop in Victoria (all modes), as a faint neutral mesh. Most are bus stops, so the dots read as texture showing how dense the stop network is — the 'where you can get on' layer beneath the rail/tram skeleton.",
      "data": {
        "url": "data/transport_stops_web.csv"
      },
      "mark": {
        "type": "circle",
        "size": 2,
        "color": "#9aa3ad",
        "opacity": 0.18,
        "stroke": null
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "MODE",
            "type": "nominal",
            "title": "Stop mode"
          }
        ]
      }
    },
    {
      "description": "Venue density across Victoria, binned to coarse lon/lat cells so the layer shows concentration without plotting 23k individual points.",
      "data": {
        "url": "data/venues_web.csv",
        "format": {
          "parse": {
            "Longitude": "number",
            "Latitude": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "round(datum.Longitude / 0.05) * 0.05",
          "as": "lon_bin"
        },
        {
          "calculate": "round(datum.Latitude / 0.04) * 0.04",
          "as": "lat_bin"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "venue_count"
            }
          ],
          "groupby": [
            "lon_bin",
            "lat_bin"
          ]
        },
        {
          "filter": "datum.venue_count >= 2"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#d1495b",
        "opacity": 0.52,
        "stroke": "#ffffff",
        "strokeWidth": 0.25
      },
      "encoding": {
        "longitude": {
          "field": "lon_bin",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat_bin",
          "type": "quantitative"
        },
        "size": {
          "field": "venue_count",
          "type": "quantitative",
          "title": "Venues per area",
          "scale": {
            "type": "sqrt",
            "range": [
              8,
              430
            ]
          },
          "legend": {
            "format": ","
          }
        },
        "tooltip": [
          {
            "field": "venue_count",
            "type": "quantitative",
            "title": "Venues in area",
            "format": ","
          }
        ]
      }
    },
    {
      "description": "Train and tram routes as lines — the legible backbone of where public transport runs, drawn over the venue density layer. Direction/express variants collapsed to one feature per route; bus routes are intentionally not drawn (they would be spaghetti and blow the data budget) and are represented by the stop mesh instead.",
      "data": {
        "url": "data/pt_routes_simplified.topojson",
        "format": {
          "type": "topojson",
          "feature": "public_transport_lines"
        }
      },
      "transform": [
        {
          "calculate": "indexof(datum.properties.MODE, 'TRAIN') >= 0 ? 'Train' : 'Tram'",
          "as": "route_group"
        }
      ],
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeWidth": 1.5,
        "strokeCap": "round"
      },
      "encoding": {
        "color": {
          "field": "route_group",
          "type": "nominal",
          "title": "Routes (train & tram)",
          "scale": {
            "domain": [
              "Train",
              "Tram"
            ],
            "range": [
              "#33475f",
              "#7e8a98"
            ]
          },
          "legend": {
            "symbolType": "stroke",
            "symbolStrokeWidth": 2
          }
        },
        "tooltip": [
          {
            "field": "properties.SHORT_NAME",
            "type": "nominal",
            "title": "Route"
          },
          {
            "field": "properties.MODE",
            "type": "nominal",
            "title": "Mode"
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent",
      "size": "independent"
    }
  }
}