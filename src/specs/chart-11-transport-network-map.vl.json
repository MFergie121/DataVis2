{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 11 — Statewide overview of where venues sit against the transport network. Train + tram routes are drawn over precomputed hexagonal venue-density cells (~8 km, built offline by tools/build-hexbins-victoria.mjs), with small train/tram stop dots over the route geometry so each stopping point reads without adding the bus-stop cloud. This is a proximity/context map, not a service-frequency map. Data: venue_hexbins_victoria.topojson (from venues_web.csv); pt_routes_simplified.topojson as lines; transport_stops_web.csv filtered to train/tram stops; sa2_summary_simplified.topojson as the base.",
  "title": {
    "text": "Victoria's venues cluster wherever the transport network is densest",
    "subtitle": [
      "Venue density (warm hexes) with train and tram routes · statewide frame."
    ],
    "anchor": "start"
  },
  "width": "container",
  "height": 520,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [-145, 0, 0],
    "center": [0, -37],
    "parallels": [-36, -38]
  },
  "layer": [
    {
      "description": "Base: SA2 boundaries for geographic context (same base as the venue map).",
      "data": {
        "url": "data/sa2_summary_simplified.topojson",
        "format": {
          "type": "topojson",
          "feature": "sa2_summary"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f0efe9",
        "stroke": "#ffffff",
        "strokeWidth": 0.4
      }
    },
    {
      "description": "Venue density across Victoria as precomputed hexagonal bins (~8 km cells). Each hexagon is a real geographic polygon built offline by tools/build-hexbins-victoria.mjs, so cells tile seamlessly under the conicEqualArea projection without any in-spec transform. Color encodes venue count per cell on a sqrt scale so both dense metro clusters and smaller regional nodes read clearly.",
      "data": {
        "url": "data/venue_hexbins_victoria.topojson",
        "format": {
          "type": "topojson",
          "feature": "venue_hexbins"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.count < 5 ? '<5' : datum.properties.count < 20 ? '5-20' : datum.properties.count < 100 ? '20-100' : '100+'",
          "as": "count_band"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.3
      },
      "encoding": {
        "color": {
          "field": "count_band",
          "type": "ordinal",
          "title": "Venues per hex cell",
          "scale": {
            "domain": ["<5", "5-20", "20-100", "100+"],
            "range": ["#bdbdbd", "#fed976", "#e31a1c", "#800026"]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 4,
            "symbolType": "square",
            "symbolSize": 100
          }
        },
        "tooltip": [
          {
            "field": "properties.count",
            "type": "quantitative",
            "title": "Venues in cell",
            "format": ","
          }
        ]
      }
    },
    {
      "description": "Train and tram routes as lines — the legible backbone of where rail/tram public transport runs, drawn over the venue density layer. Direction/express variants collapsed to one feature per route; bus routes are intentionally not drawn to keep the statewide frame readable.",
      "data": {
        "url": "data/pt_routes_simplified.topojson",
        "format": {
          "type": "topojson",
          "feature": "public_transport_lines"
        }
      },
      "transform": [
        {
          "calculate": "indexof(datum.properties.MODE, 'TRAIN') >= 0 ? 'Train' : 'Tram'",
          "as": "route_group"
        }
      ],
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeWidth": 1.5,
        "strokeCap": "round",
        "interactive": false
      },
      "encoding": {
        "color": {
          "field": "route_group",
          "type": "nominal",
          "title": "Routes (train & tram)",
          "scale": {
            "domain": ["Train", "Tram"],
            "range": ["#33475f", "#7e8a98"]
          },
          "legend": {
            "symbolType": "stroke",
            "symbolStrokeWidth": 2,
            "orient": "bottom",
            "direction": "horizontal"
          }
        }
      }
    },
    {
      "description": "Train/tram stops only. These small dots make the route strokes read as a stopping network without reintroducing the full bus-stop cloud.",
      "data": {
        "url": "data/transport_stops_web.csv"
      },
      "transform": [
        {
          "filter": "indexof(datum.MODE, 'TRAIN') >= 0 || indexof(datum.MODE, 'TRAM') >= 0"
        },
        {
          "calculate": "'Train/tram stops'",
          "as": "stop_layer"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 9,
        "filled": true,
        "stroke": "#26384f",
        "strokeWidth": 0.45,
        "opacity": 0.92,
        "interactive": false
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "color": {
          "field": "stop_layer",
          "type": "nominal",
          "title": "Stops",
          "scale": {
            "domain": ["Train/tram stops"],
            "range": ["#f8f7f1"]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "circle",
            "symbolSize": 70,
            "symbolStrokeColor": "#26384f",
            "symbolStrokeWidth": 1
          }
        }
      }
    },
    {
      "description": "In-chart badge reinforcing that this is a proximity map, not a service-frequency map.",
      "data": {
        "values": [{}]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "fontSize": 10,
        "fontStyle": "italic",
        "color": "#666",
        "x": {
          "expr": "8"
        },
        "y": {
          "expr": "height - 8"
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent"
    }
  }
}
