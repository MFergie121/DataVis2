{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 20 — Larger-cohort check for access vs survival by SA2. One dot per SA2 with at least 10 venues in the July 2022 cohort: fixed public-transport access (share of the SA2's venues within 400 m of a stop, x) against licence survival at the selected 1/2/3-year horizon (y), coloured Metro/Regional and sized by cohort count. This now mirrors chart-17's dynamic survival definition but uses the stricter cohort-size filter that the old hospitality-health chart used for stability. Association only. Data: chart_sa2_survival.csv.",
  "title": {
    "text": "The bigger local cohorts tell the same story",
    "subtitle": [
      "Each dot is an SA2 with at least 10 July 2022 venues.",
      "Pick how long survival means: one, two or three years after July 2022."
    ],
    "anchor": "start",
    "subtitleFontStyle": "italic"
  },
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/chart_sa2_survival.csv",
    "format": {
      "parse": {
        "sa2_code_2021": "string"
      }
    }
  },
  "params": [
    {
      "name": "horizonYears",
      "value": 2,
      "bind": {
        "input": "select",
        "options": [
          1,
          2,
          3
        ],
        "labels": [
          "1 year (still open July 2023)",
          "2 years (still open July 2024)",
          "3 years (still open July 2025)"
        ],
        "name": "Survival horizon: "
      }
    },
    {
      "name": "selected_sa2",
      "value": null
    }
  ],
  "transform": [
    {
      "filter": "datum.metro_regional_majority == 'Metro' || datum.metro_regional_majority == 'Regional'"
    },
    {
      "filter": "datum.cohort_count >= 10"
    },
    {
      "calculate": "datum.share_400",
      "as": "access_share_T"
    },
    {
      "calculate": "horizonYears === 1 ? datum.survival_rate_1yr_pct : (horizonYears === 2 ? datum.survival_rate_2yr_pct : datum.survival_rate_3yr_pct)",
      "as": "survival_rate_T"
    },
    {
      "calculate": "horizonYears + (horizonYears === 1 ? ' year' : ' years')",
      "as": "horizon_label_T"
    }
  ],
  "encoding": {
    "x": {
      "field": "access_share_T",
      "type": "quantitative",
      "title": "Venues within 400 m of public transport (%)",
      "axis": {
        "format": ".0f"
      },
      "scale": {
        "domain": [
          0,
          100
        ]
      }
    },
    "y": {
      "field": "survival_rate_T",
      "type": "quantitative",
      "title": "Venues still licensed at selected horizon (%)",
      "scale": {
        "domain": [
          45,
          100
        ]
      },
      "axis": {
        "format": ".0f"
      }
    },
    "color": {
      "field": "metro_regional_majority",
      "type": "nominal",
      "title": "Region",
      "scale": {
        "domain": [
          "Metro",
          "Regional"
        ],
        "range": [
          "#1b9e77",
          "#d95f02"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal"
      }
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "pick_20",
          "select": {
            "type": "point",
            "fields": [
              "sa2_code_2021"
            ],
            "on": "click",
            "toggle": "event.shiftKey"
          }
        }
      ],
      "mark": {
        "type": "circle"
      },
      "encoding": {
        "size": {
          "field": "cohort_count",
          "type": "quantitative",
          "title": "Venues (2022)",
          "scale": {
            "range": [
              25,
              420
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "format": ",.0f"
          }
        },
        "opacity": {
          "condition": {
            "test": "selected_sa2 == null || datum.sa2_code_2021 == selected_sa2",
            "value": 0.5
          },
          "value": 0.08
        },
        "stroke": {
          "condition": {
            "test": "selected_sa2 != null && datum.sa2_code_2021 == selected_sa2",
            "value": "#1a1a1a"
          },
          "value": null
        },
        "strokeWidth": {
          "value": 1.4
        },
        "tooltip": [
          {
            "field": "sa2_name_2021",
            "type": "nominal",
            "title": "SA2"
          },
          {
            "field": "metro_regional_majority",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "access_share_T",
            "type": "quantitative",
            "title": "Within 400 m",
            "format": ".1f"
          },
          {
            "field": "horizon_label_T",
            "type": "nominal",
            "title": "Survival horizon"
          },
          {
            "field": "survival_rate_T",
            "type": "quantitative",
            "title": "Still licensed",
            "format": ".1f"
          },
          {
            "field": "cohort_count",
            "type": "quantitative",
            "title": "Venues (2022)",
            "format": ",.0f"
          },
          {
            "field": "median_nearest_stop_distance_m",
            "type": "quantitative",
            "title": "Median walk to stop (m)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "regression": "survival_rate_T",
          "on": "access_share_T",
          "groupby": [
            "metro_regional_majority"
          ]
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 3
      }
    },
    {
      "description": "Interpretive annotation that states what a strong positive access effect would look like.",
      "data": {
        "values": [
          {
            "access_share_T": 6,
            "survival_rate_T": 96
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 4,
        "dy": 4,
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#5b5b5b",
        "limit": 340,
        "text": "If access strongly improved survival, these lines would rise clearly from left to right."
      },
      "encoding": {
        "color": null
      }
    }
  ]
}
