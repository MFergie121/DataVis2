{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 13 — Licensed venues, up close on Melbourne. The venue counterpart to chart-12: the same inner-Melbourne frame (lon 144.75–145.35, lat −37.92 to −37.67) and SA2 base, with venue points filtered in-spec from the shared venues_web.csv. Pairs side-by-side with chart-12 so the reader can see venues sitting on the dense tram/train core. Equal-area projection (dot density depends on dots per unit area). Colour is a muted venue-category scheme (tableau10).",
  "title": {
    "text": "Venues — inner Melbourne",
    "anchor": "start"
  },
  "width": "container",
  "height": 250,
  "autosize": { "type": "fit-x", "contains": "padding" },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [-145, 0, 0],
    "center": [0, -37],
    "parallels": [-36, -38]
  },
  "layer": [
    {
      "description": "Base: inner-Melbourne SA2 boundaries (shared with chart-12).",
      "data": {
        "url": "data/sa2_melbourne.topojson",
        "format": { "type": "topojson", "feature": "sa2_summary" }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f0efe9",
        "stroke": "#ffffff",
        "strokeWidth": 0.4
      }
    },
    {
      "description": "Venue points within the Melbourne frame, filtered in-spec from the shared statewide venues CSV.",
      "data": {
        "url": "data/venues_web.csv",
        "format": { "parse": { "Longitude": "number", "Latitude": "number", "sa2_code_2021": "string" } }
      },
      "transform": [
        { "filter": "datum.Longitude >= 144.75 && datum.Longitude <= 145.35 && datum.Latitude >= -37.92 && datum.Latitude <= -37.67" }
      ],
      "mark": { "type": "circle", "size": 9, "opacity": 0.5, "stroke": null },
      "encoding": {
        "longitude": { "field": "Longitude", "type": "quantitative" },
        "latitude": { "field": "Latitude", "type": "quantitative" },
        "color": {
          "field": "venue_category_group",
          "type": "nominal",
          "title": "Venue type",
          "scale": { "scheme": "tableau10" },
          "legend": { "symbolOpacity": 1, "symbolSize": 60, "columns": 1 }
        },
        "tooltip": [
          { "field": "venue_category_group", "type": "nominal", "title": "Type" },
          { "field": "metro_regional_label", "type": "nominal", "title": "Region" },
          { "field": "nearest_stop_distance_m", "type": "quantitative", "title": "Nearest stop (m)", "format": ",.0f" },
          { "field": "distance_band", "type": "nominal", "title": "Distance band" }
        ]
      }
    }
  ],
  "resolve": { "scale": { "color": "independent" } }
}
