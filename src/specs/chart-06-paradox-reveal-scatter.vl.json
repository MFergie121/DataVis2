{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 06 — Metro-vs-regional access strip plot. One jittered dot per SA2 (≥10 venues), placed horizontally by the share of that SA2's venues within 400 m of a stop, split into a Metro band (teal) and a Regional band (orange) and sized by venue count. It carries section 2's comparative claim — Greater Melbourne hospitality sits on far better transport access than regional Victoria — now that the access map (chart-03) is zoomed to metro only and can no longer show the contrast itself. A short tick + label marks each band's mean (metro ≈87%, regional ≈59%). The teal/orange split deliberately rhymes with chart-16 in §3, where the same two groups reappear and regional out-survives metro despite less access. Receives and emits the page-wide selected_sa2 highlight; clicking a regional dot highlights it here and on the statewide §3 charts, but leaves the metro-only map fully lit (handled in index.html). Data: sa2_summary_web.csv.",
  "title": {
    "text": "Melbourne's venues are far more likely to sit near transport",
    "subtitle": [
      "Each dot is an SA2 with at least 10 venues, placed by the share of its venues within 400 m of a stop.",
      "Metro areas crowd up against 100%; regional Victoria trails well behind."
    ],
    "anchor": "start",
    "subtitleFontStyle": "italic"
  },
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/sa2_summary_web.csv",
    "format": {
      "parse": {
        "sa2_code_2021": "string"
      }
    }
  },
  "params": [
    {
      "name": "selected_sa2",
      "value": null
    }
  ],
  "transform": [
    {
      "filter": "datum.metro_regional_majority == 'Metro' || datum.metro_regional_majority == 'Regional'"
    },
    {
      "filter": "datum.access_share_pct != null"
    },
    {
      "filter": "datum.venue_count >= 10"
    },
    {
      "calculate": "random()",
      "as": "jitter"
    }
  ],
  "encoding": {
    "x": {
      "field": "access_share_pct",
      "type": "quantitative",
      "title": "Share of an SA2's venues within 400 m of a stop (%)",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "axis": {
        "values": [
          0,
          20,
          40,
          60,
          80,
          100
        ],
        "format": ".0f",
        "grid": true
      }
    },
    "y": {
      "field": "metro_regional_majority",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Metro",
          "Regional"
        ]
      },
      "axis": {
        "labelFontSize": 13,
        "labelFontWeight": "bold",
        "labelPadding": 6,
        "domain": false,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "pick_06",
          "select": {
            "type": "point",
            "fields": [
              "sa2_code_2021"
            ],
            "on": "click",
            "clear": "dblclick"
          }
        }
      ],
      "mark": {
        "type": "circle"
      },
      "encoding": {
        "yOffset": {
          "field": "jitter",
          "type": "quantitative"
        },
        "color": {
          "field": "metro_regional_majority",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Metro",
              "Regional"
            ],
            "range": [
              "#1b9e77",
              "#d95f02"
            ]
          }
        },
        "size": {
          "field": "venue_count",
          "type": "quantitative",
          "title": "Venues in SA2",
          "scale": {
            "domain": [
              10,
              700
            ],
            "range": [
              20,
              420
            ]
          },
          "legend": {
            "orient": "bottom-right",
            "format": "d",
            "values": [
              25,
              200,
              600
            ]
          }
        },
        "opacity": {
          "condition": {
            "test": "selected_sa2 == null || datum.sa2_code_2021 == selected_sa2",
            "value": 0.55
          },
          "value": 0.08
        },
        "stroke": {
          "condition": {
            "test": "selected_sa2 != null && datum.sa2_code_2021 == selected_sa2",
            "value": "#1a1a1a"
          },
          "value": null
        },
        "strokeWidth": {
          "value": 1.4
        },
        "tooltip": [
          {
            "field": "sa2_name_2021",
            "type": "nominal",
            "title": "SA2"
          },
          {
            "field": "metro_regional_majority",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "access_share_pct",
            "type": "quantitative",
            "title": "Venues within 400 m",
            "format": ".0f"
          },
          {
            "field": "venue_count",
            "type": "quantitative",
            "title": "Venues",
            "format": ","
          },
          {
            "field": "median_nearest_stop_distance_m",
            "type": "quantitative",
            "title": "Median walk to stop (m)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "description": "Per-band mean access: a short vertical tick at the group average, so the ~28-point metro/regional gap reads as a single comparison.",
      "transform": [
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "access_share_pct",
              "as": "mean_access"
            }
          ],
          "groupby": [
            "metro_regional_majority"
          ]
        }
      ],
      "mark": {
        "type": "tick",
        "thickness": 3,
        "size": 70,
        "color": "#2f3a3d",
        "opacity": 0.9
      },
      "encoding": {
        "x": {
          "field": "mean_access",
          "type": "quantitative"
        }
      }
    },
    {
      "description": "Label for each band's mean, sitting just above the tick.",
      "transform": [
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "access_share_pct",
              "as": "mean_access"
            }
          ],
          "groupby": [
            "metro_regional_majority"
          ]
        },
        {
          "calculate": "'avg ' + format(datum.mean_access, '.0f') + '%'",
          "as": "mean_label"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -40,
        "fontWeight": "bold",
        "fontSize": 12,
        "color": "#2f3a3d"
      },
      "encoding": {
        "x": {
          "field": "mean_access",
          "type": "quantitative"
        },
        "text": {
          "field": "mean_label",
          "type": "nominal"
        }
      }
    },
    {
      "description": "Callout anchoring the gap as the section's setup: metro has the access advantage, so it has the most to gain.",
      "data": {
        "values": [
          {
            "x": 2,
            "y": "Regional",
            "label": [
              "A ~28-point access gap.",
              "If proximity to transport is",
              "an advantage, metro holds it."
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dy": 36,
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#555",
        "lineHeight": 15
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "nominal"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ]
}
