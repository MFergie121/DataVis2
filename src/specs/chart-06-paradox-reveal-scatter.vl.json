{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 06 — Transport intensity scatter. One point per SA2 with at least 10 venues: the median number of stops within 400 m of each venue (x) against the SA2's venue count (y, log scale), coloured metro/regional. This replaces the old SEIFA-decile paradox chart so section 2 builds the expectation that hospitality is organised around stop-rich transport nodes, not merely near any one stop. Labels identify major clusters such as the Melbourne CBD, Fitzroy, Geelong, St Kilda and Southbank. Receives and emits the page-wide selected_sa2 highlight.",
  "title": {
    "text": "The biggest hospitality clusters sit in stop-rich places",
    "subtitle": [
      "Each dot is an SA2. The x-axis counts how many stops the typical venue has within 400 m;",
      "the largest clusters sit where that local transport mesh is thickest."
    ],
    "anchor": "start",
    "subtitleFontStyle": "italic"
  },
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/sa2_summary_web.csv",
    "format": {
      "parse": {
        "sa2_code_2021": "string"
      }
    }
  },
  "params": [
    {
      "name": "selected_sa2",
      "value": null
    }
  ],
  "transform": [
    {
      "filter": "datum.metro_regional_majority == 'Metro' || datum.metro_regional_majority == 'Regional'"
    },
    {
      "filter": "datum.median_stops_within_400m != null"
    },
    {
      "filter": "datum.venue_count >= 10"
    }
  ],
  "encoding": {
    "x": {
      "field": "median_stops_within_400m",
      "type": "quantitative",
      "title": "Median stops within 400 m of a venue",
      "scale": {
        "domain": [
          0,
          26
        ]
      },
      "axis": {
        "tickMinStep": 2,
        "grid": true
      }
    },
    "y": {
      "field": "venue_count",
      "type": "quantitative",
      "title": "Licensed hospitality venues in the SA2",
      "scale": {
        "type": "log",
        "domain": [
          10,
          700
        ]
      },
      "axis": {
        "values": [
          10,
          20,
          50,
          100,
          200,
          500
        ],
        "format": ","
      }
    },
    "color": {
      "field": "metro_regional_majority",
      "type": "nominal",
      "title": "Region",
      "legend": null,
      "scale": {
        "domain": [
          "Metro",
          "Regional"
        ],
        "range": [
          "#1b9e77",
          "#d95f02"
        ]
      }
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "pick_06",
          "select": {
            "type": "point",
            "fields": [
              "sa2_code_2021"
            ],
            "on": "click",
            "clear": "dblclick"
          }
        }
      ],
      "mark": {
        "type": "circle"
      },
      "encoding": {
        "opacity": {
          "condition": {
            "test": "selected_sa2 == null || datum.sa2_code_2021 == selected_sa2",
            "value": 0.58
          },
          "value": 0.08
        },
        "size": {
          "condition": {
            "test": "selected_sa2 != null && datum.sa2_code_2021 == selected_sa2",
            "value": 240
          },
          "value": 46
        },
        "stroke": {
          "condition": {
            "test": "selected_sa2 != null && datum.sa2_code_2021 == selected_sa2",
            "value": "#1a1a1a"
          },
          "value": null
        },
        "strokeWidth": {
          "value": 1.2
        },
        "tooltip": [
          {
            "field": "sa2_name_2021",
            "type": "nominal",
            "title": "SA2"
          },
          {
            "field": "metro_regional_majority",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "venue_count",
            "type": "quantitative",
            "title": "Venues",
            "format": ","
          },
          {
            "field": "median_stops_within_400m",
            "type": "quantitative",
            "title": "Median stops within 400 m",
            "format": ".0f"
          },
          {
            "field": "access_share_pct",
            "type": "quantitative",
            "title": "Venues within 400 m",
            "format": ".0f"
          },
          {
            "field": "median_nearest_stop_distance_m",
            "type": "quantitative",
            "title": "Median walk to stop (m)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "regression": "venue_count",
          "on": "median_stops_within_400m",
          "method": "log",
          "groupby": [
            "metro_regional_majority"
          ],
          "extent": [
            0,
            26
          ]
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "opacity": 0.8
      }
    },
    {
      "description": "Labels for recognisable large clusters that sit at different points in the transport mesh.",
      "transform": [
        {
          "filter": "indexof(['Melbourne CBD - East', 'Melbourne CBD - West', 'Fitzroy', 'Geelong', 'St Kilda', 'Southbank'], datum.sa2_name_2021) >= 0"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 7,
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "sa2_name_2021"
        },
        "opacity": {
          "condition": {
            "test": "selected_sa2 == null || datum.sa2_code_2021 == selected_sa2",
            "value": 0.88
          },
          "value": 0.18
        }
      }
    },
    {
      "description": "Narrative callout anchoring the expectation: the CBD is not just near transport, it is surrounded by stops.",
      "data": {
        "values": [
          {
            "x": 24.8,
            "y": 420
          }
        ]
      },
      "mark": {
        "type": "text",
        "text": [
          "CBD venues are not just close",
          "to one stop; the typical venue",
          "has about 25 nearby stops."
        ],
        "align": "right",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#2f3a3d"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "color": null
      }
    },
    {
      "description": "Direct labels for the region trend lines.",
      "data": {
        "values": [
          {
            "x": 18,
            "y": 190,
            "label": "Metro clusters climb with stop richness",
            "region": "Metro"
          },
          {
            "x": 9,
            "y": 55,
            "label": "Regional clusters are smaller",
            "region": "Regional"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "field": "region",
          "type": "nominal",
          "scale": {
            "domain": [
              "Metro",
              "Regional"
            ],
            "range": [
              "#1b9e77",
              "#d95f02"
            ]
          },
          "legend": null
        }
      }
    }
  ]
}
