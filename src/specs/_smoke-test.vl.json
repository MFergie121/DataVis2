{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Scaffold smoke-test. Proves the runtime loads a CSV from src/data/ and renders with the metro/regional duotone. Not a deliverable chart — remove once chart-01 lands. Source: chart_metro_regional_summary.csv.",
  "title": {
    "text": "Smoke test: share of venues within 400 m of a stop",
    "subtitle": "Scaffold only — confirms data load + render. Replace with real charts.",
    "anchor": "start"
  },
  "width": "container",
  "height": 220,
  "data": {
    "url": "data/chart_metro_regional_summary.csv"
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 2
  },
  "encoding": {
    "x": {
      "field": "metro_regional_label",
      "type": "nominal",
      "title": null,
      "axis": { "labelAngle": 0 }
    },
    "y": {
      "field": "share_within_400m_pt",
      "type": "quantitative",
      "title": "Within 400 m of a stop",
      "axis": { "format": ".0%" },
      "scale": { "domain": [0, 1] }
    },
    "color": {
      "field": "metro_regional_label",
      "type": "nominal",
      "scale": {
        "domain": ["Metro", "Regional"],
        "range": ["#1b9e77", "#d95f02"]
      },
      "legend": null
    },
    "tooltip": [
      { "field": "metro_regional_label", "type": "nominal", "title": "Region" },
      { "field": "venue_count", "type": "quantitative", "title": "Venues", "format": "," },
      { "field": "share_within_400m_pt", "type": "quantitative", "title": "Within 400 m", "format": ".1%" }
    ]
  }
}
