{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 01 — Venue point map. Where Victoria's ~23,658 licensed venues are, over a light base of SA2 boundaries, on an equal-area projection of Victoria. Equal-area suits a dot map because the perceived density depends on dots per unit area. Points are small and semi-transparent to manage overplotting; colour is a muted categorical hue for venue type. This view is the target of the choropleth's linked filter (wired in module #5). Data: venues_web.csv over sa2_summary_simplified.topojson.",
  "width": "container",
  "height": 460,
  "autosize": { "type": "fit-x", "contains": "padding" },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [-145, 0, 0],
    "center": [0, -37],
    "parallels": [-36, -38]
  },
  "layer": [
    {
      "description": "Base: SA2 boundaries for geographic context.",
      "data": {
        "url": "data/sa2_summary_simplified.topojson",
        "format": { "type": "topojson", "feature": "sa2_summary" }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f0efe9",
        "stroke": "#ffffff",
        "strokeWidth": 0.4
      }
    },
    {
      "description": "Venue points.",
      "data": { "url": "data/venues_web.csv" },
      "mark": {
        "type": "circle",
        "size": 5,
        "opacity": 0.35,
        "stroke": null
      },
      "encoding": {
        "longitude": { "field": "Longitude", "type": "quantitative" },
        "latitude": { "field": "Latitude", "type": "quantitative" },
        "color": {
          "field": "venue_category_group",
          "type": "nominal",
          "title": "Venue type",
          "scale": {
            "scheme": "tableau10"
          },
          "legend": { "symbolOpacity": 1, "symbolSize": 60, "columns": 1 }
        },
        "tooltip": [
          { "field": "venue_category_group", "type": "nominal", "title": "Type" },
          { "field": "metro_regional_label", "type": "nominal", "title": "Region" },
          { "field": "nearest_stop_distance_m", "type": "quantitative", "title": "Nearest stop (m)", "format": ",.0f" },
          { "field": "distance_band", "type": "nominal", "title": "Distance band" }
        ]
      }
    }
  ],
  "resolve": { "scale": { "color": "independent" } }
}
