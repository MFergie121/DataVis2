{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 18 — Where venues last, mapped. Two-year survival of the July 2023 liquor-licence cohort by SA2 (still licensed July 2025), on the same equal-area projection of Victoria as the other choropleths. Colour carries survival; it is high and fairly even statewide (mostly 85–95%), with no obvious 'near the city / near transport' advantage — the spatial echo of the access map (chart-03). SA2s with fewer than 5 cohort venues are left ungraded (grey) to avoid noisy rates. A text callout anchored on the alpine north-east makes the 'high even far from rail' point explicit. This map is one node of the §3 linked highlight: pick_18 captures a clicked SA2 and selected_sa2 (driven from the access×survival scatter chart-17 or the 'find your suburb' box) dims every other region, so a single SA2 stays lit on both the map and the scatter at once — the reader can pin a high-access suburb and watch it sit on the flat survival cloud. Survival is a licence-presence proxy; association only. Data: chart_sa2_survival.csv joined to sa2_summary_simplified.topojson on sa2_code_2021.",
  "title": {
    "text": "Venues last across most of Victoria — city or country",
    "subtitle": [
      "Two-year survival of 2023 venues by SA2. Click a region to pin it on the scatter above.",
      "Grey = fewer than 5 venues (rate too noisy to show)."
    ],
    "anchor": "start",
    "subtitleFontStyle": "italic"
  },
  "width": "container",
  "height": 460,
  "params": [
    {
      "name": "selected_sa2",
      "value": null
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -145,
      0,
      0
    ],
    "center": [
      0,
      -37
    ],
    "parallels": [
      -36,
      -38
    ]
  },
  "layer": [
    {
      "params": [
        {
          "name": "pick_18",
          "select": {
            "type": "point",
            "fields": [
              "sa2_code_2021"
            ],
            "on": "click",
            "toggle": "event.shiftKey"
          }
        }
      ],
      "data": {
        "url": "data/sa2_summary_simplified.topojson",
        "format": {
          "type": "topojson",
          "feature": "sa2_summary"
        }
      },
      "transform": [
        {
          "lookup": "properties.sa2_code_2021",
          "from": {
            "data": {
              "url": "data/chart_sa2_survival.csv",
              "format": {
                "parse": {
                  "sa2_code_2021": "string"
                }
              }
            },
            "key": "sa2_code_2021",
            "fields": [
              "survival_rate_pct",
              "sa2_name_2021",
              "metro_regional_majority",
              "cohort_count",
              "access_share_pct",
              "median_nearest_stop_distance_m",
              "irsad_aus_decile"
            ]
          }
        },
        {
          "calculate": "datum.properties.sa2_code_2021",
          "as": "sa2_code_2021"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.3
      },
      "encoding": {
        "color": {
          "field": "survival_rate_pct",
          "type": "quantitative",
          "title": [
            "Survived two",
            "years (%)"
          ],
          "scale": {
            "scheme": "teals",
            "domain": [
              80,
              100
            ]
          },
          "legend": {
            "format": ".0f",
            "gradientLength": 160
          }
        },
        "opacity": {
          "condition": {
            "test": "selected_sa2 == null || datum.sa2_code_2021 == selected_sa2",
            "value": 1
          },
          "value": 0.25
        },
        "stroke": {
          "condition": {
            "test": "selected_sa2 != null && datum.sa2_code_2021 == selected_sa2",
            "value": "#1a1a1a"
          },
          "value": "#ffffff"
        },
        "strokeWidth": {
          "condition": {
            "test": "selected_sa2 != null && datum.sa2_code_2021 == selected_sa2",
            "value": 1.6
          },
          "value": 0.3
        },
        "tooltip": [
          {
            "field": "sa2_name_2021",
            "type": "nominal",
            "title": "SA2"
          },
          {
            "field": "metro_regional_majority",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "survival_rate_pct",
            "type": "quantitative",
            "title": "Survived 2 yrs",
            "format": ".1f"
          },
          {
            "field": "access_share_pct",
            "type": "quantitative",
            "title": "Within 400 m of a stop",
            "format": ".0f"
          },
          {
            "field": "median_nearest_stop_distance_m",
            "type": "quantitative",
            "title": "Median walk to stop (m)",
            "format": ","
          },
          {
            "field": "irsad_aus_decile",
            "type": "ordinal",
            "title": "SEIFA decile"
          },
          {
            "field": "cohort_count",
            "type": "quantitative",
            "title": "Venues (2023)",
            "format": ","
          }
        ]
      }
    },
    {
      "description": "Callout on the alpine north-east, where venues survive as well as the transport-rich core despite no rail nearby.",
      "data": {
        "values": [
          {
            "lon": 146.95,
            "lat": -36.73,
            "label": "Alpine towns survive ~94% — far from any train"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -10,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#1a3a3a"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "description": "Caveat badge: survival is a licence-presence proxy — a ceased licence can be a sale or rename, not only a closure.",
      "data": {
        "values": [
          {
            "lon": 140.95,
            "lat": -39.1
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "fontStyle": "italic",
        "fontSize": 10,
        "color": "#999",
        "text": "survival = licence presence (proxy)"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    }
  ]
}