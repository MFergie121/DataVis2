{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 18 — Where venues last, mapped. Survival of the July 2022 liquor-licence cohort by SA2 at the selected 1/2/3-year horizon, on the same equal-area projection of Victoria as the other choropleths. Colour carries fixed survival classes (<70%, 70–79%, 80–89%, 90–100%) so the legend means the same thing across horizons; survival declines as the horizon lengthens, but there is still no obvious 'near the city / near transport' advantage — the spatial echo of chart-17. SA2s with fewer than 5 cohort venues are left ungraded (grey) to avoid noisy rates. This map is one node of the §3 linked highlight: pick_18 captures a clicked SA2 and selected_sa2 dims every other region, so a single SA2 stays lit on both the map and the scatter at once. Survival is a licence-presence proxy; association only. Data: chart_sa2_survival.csv joined to sa2_summary_simplified.topojson on sa2_code_2021.",
  "title": {
    "text": "Venues last across most of Victoria — city or country",
    "subtitle": [
      "July 2022 venues by SA2. Pick the survival horizon; click a region to pin it above.",
      "Colour uses fixed survival bands; grey = fewer than 5 venues (rate too noisy to show).",
      "Alpine towns still survive at about 94%, despite being far from any train."
    ],
    "anchor": "start",
    "subtitleFontStyle": "italic"
  },
  "width": "container",
  "height": 460,
  "params": [
    {
      "name": "horizonYears",
      "value": 2,
      "bind": {
        "input": "select",
        "options": [
          1,
          2,
          3
        ],
        "labels": [
          "1 year (still open July 2023)",
          "2 years (still open July 2024)",
          "3 years (still open July 2025)"
        ],
        "name": "Survival horizon: "
      }
    },
    {
      "name": "selected_sa2",
      "value": null
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -145,
      0,
      0
    ],
    "center": [
      0,
      -37
    ],
    "parallels": [
      -36,
      -38
    ]
  },
  "layer": [
    {
      "params": [
        {
          "name": "pick_18",
          "select": {
            "type": "point",
            "fields": [
              "sa2_code_2021"
            ],
            "on": "click",
            "toggle": "event.shiftKey"
          }
        }
      ],
      "data": {
        "url": "data/sa2_summary_simplified.topojson",
        "format": {
          "type": "topojson",
          "feature": "sa2_summary"
        }
      },
      "transform": [
        {
          "lookup": "properties.sa2_code_2021",
          "from": {
            "data": {
              "url": "data/chart_sa2_survival.csv",
              "format": {
                "parse": {
                  "sa2_code_2021": "string"
                }
              }
            },
            "key": "sa2_code_2021",
            "fields": [
              "survival_rate_pct",
              "survival_rate_1yr_pct",
              "survival_rate_2yr_pct",
              "survival_rate_3yr_pct",
              "sa2_name_2021",
              "metro_regional_majority",
              "cohort_count",
              "access_share_pct",
              "median_nearest_stop_distance_m",
              "irsad_aus_decile"
            ]
          }
        },
        {
          "calculate": "datum.properties.sa2_code_2021",
          "as": "sa2_code_2021"
        },
        {
          "calculate": "horizonYears === 1 ? datum.survival_rate_1yr_pct : (horizonYears === 2 ? datum.survival_rate_2yr_pct : datum.survival_rate_3yr_pct)",
          "as": "survival_rate_T"
        },
        {
          "calculate": "horizonYears + (horizonYears === 1 ? ' year' : ' years')",
          "as": "horizon_label_T"
        },
        {
          "calculate": "datum.survival_rate_T == null ? 'Fewer than 5 venues' : (datum.survival_rate_T < 70 ? '<70%' : (datum.survival_rate_T < 80 ? '70-79%' : (datum.survival_rate_T < 90 ? '80-89%' : '90-100%')))",
          "as": "survival_class"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.3
      },
      "encoding": {
        "color": {
          "field": "survival_class",
          "type": "ordinal",
          "title": [
            "Survived selected",
            "horizon (%)"
          ],
          "scale": {
            "domain": [
              "<70%",
              "70-79%",
              "80-89%",
              "90-100%",
              "Fewer than 5 venues"
            ],
            "range": [
              "#ccece6",
              "#66c2a4",
              "#238b7d",
              "#00584f",
              "#cccccc"
            ]
          },
          "legend": {
            "symbolType": "square",
            "symbolSize": 150
          }
        },
        "opacity": {
          "condition": {
            "test": "selected_sa2 == null || datum.sa2_code_2021 == selected_sa2",
            "value": 1
          },
          "value": 0.25
        },
        "stroke": {
          "condition": {
            "test": "selected_sa2 != null && datum.sa2_code_2021 == selected_sa2",
            "value": "#1a1a1a"
          },
          "value": "#ffffff"
        },
        "strokeWidth": {
          "condition": {
            "test": "selected_sa2 != null && datum.sa2_code_2021 == selected_sa2",
            "value": 1.6
          },
          "value": 0.3
        },
        "tooltip": [
          {
            "field": "sa2_name_2021",
            "type": "nominal",
            "title": "SA2"
          },
          {
            "field": "metro_regional_majority",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "survival_rate_T",
            "type": "quantitative",
            "title": "Still licensed",
            "format": ".1f"
          },
          {
            "field": "survival_class",
            "type": "ordinal",
            "title": "Mapped class"
          },
          {
            "field": "horizon_label_T",
            "type": "nominal",
            "title": "Survival horizon"
          },
          {
            "field": "access_share_pct",
            "type": "quantitative",
            "title": "Within 400 m of a stop",
            "format": ".0f"
          },
          {
            "field": "median_nearest_stop_distance_m",
            "type": "quantitative",
            "title": "Median walk to stop (m)",
            "format": ",.0f"
          },
          {
            "field": "irsad_aus_decile",
            "type": "ordinal",
            "title": "SEIFA decile"
          },
          {
            "field": "cohort_count",
            "type": "quantitative",
            "title": "Venues (2022)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "description": "Leader line from the Alpine annotation to Bright - Mount Beauty, the high-survival low-access alpine SA2.",
      "data": {
        "values": [
          {
            "lon": 146.35,
            "lat": -35.65,
            "order": 1
          },
          {
            "lon": 146.96,
            "lat": -36.73,
            "order": 2
          }
        ]
      },
      "mark": {
        "type": "line",
        "stroke": "#1a1a1a",
        "strokeWidth": 1,
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "order": {
          "field": "order",
          "type": "ordinal"
        }
      }
    },
    {
      "description": "Arrowhead at Bright - Mount Beauty.",
      "data": {
        "values": [
          {
            "lon": 146.96,
            "lat": -36.73
          }
        ]
      },
      "mark": {
        "type": "point",
        "shape": "triangle-down",
        "angle": 25,
        "filled": true,
        "size": 70,
        "color": "#1a1a1a"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    },
    {
      "description": "Alpine callout text in the top-right quarter. Values use the same selected survival horizon as the choropleth.",
      "data": {
        "values": [
          {
            "lon": 146.2,
            "lat": -35.45,
            "access_share_pct": 34.6,
            "survival_rate_1yr_pct": 91.0,
            "survival_rate_2yr_pct": 91.0,
            "survival_rate_3yr_pct": 86.0
          }
        ]
      },
      "transform": [
        {
          "calculate": "horizonYears === 1 ? datum.survival_rate_1yr_pct : (horizonYears === 2 ? datum.survival_rate_2yr_pct : datum.survival_rate_3yr_pct)",
          "as": "survival_rate_T"
        },
        {
          "calculate": "['Alpine', format(datum.access_share_pct, '.0f') + '% venue proximity', format(datum.survival_rate_T, '.0f') + '% survival']",
          "as": "calloutLabel"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "lineHeight": 14,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#1a1a1a"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "calloutLabel",
          "type": "nominal"
        }
      }
    },
    {
      "description": "Caveat badge: survival is a licence-presence proxy — a ceased licence can be a sale or rename, not only a closure.",
      "data": {
        "values": [
          {
            "lon": 140.95,
            "lat": -39.1
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "fontStyle": "italic",
        "fontSize": 10,
        "color": "#999",
        "text": "survival = licence presence (proxy)"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    }
  ]
}
